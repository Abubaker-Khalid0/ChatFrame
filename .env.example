# ChatFrame environment configuration
# Copy this file to `.env` and adjust as needed. `.env` is gitignored.
# These defaults are configurable without changing source code (FR-009).

# Backend (Fastify) local service port.
BACKEND_PORT=3714

# Frontend (Vite dev server) port.
FRONTEND_PORT=5173

# Base URL the frontend uses to reach the backend (FR-008).
# Exposed to the browser via Vite's VITE_ prefix.
VITE_BACKEND_URL=http://localhost:3714

# Use the synthetic mock adapter instead of a real WhatsApp connection (FR-015).
# Set to `true` to enable mock mode; leave unset/false for real mode.
MOCK_MODE=false

# Directory where WhatsApp session files are stored (FR-012, Constitution XIII).
# Lives OUTSIDE the projects/ folder — session files are never part of any
# project, export, or log output.
SESSION_DIR=./chatframe-data/sessions
